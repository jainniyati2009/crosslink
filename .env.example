# Neon pooled URL for application requests
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Neon direct URL for migrations; omit only when the same URL is direct
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
APP_ORIGIN="http://localhost:3000"
GOOGLE_WORKSPACE_DOMAIN="nsut.ac.in"
