generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}
enum UserStatus {
  ACTIVE
  SUSPENDED
}
enum DiscussionCategory {
  CAMPUS
  ACADEMICS
  QUESTION
  RESOURCE
}
enum Visibility {
  VISIBLE
  HIDDEN
  DELETED
}
enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum AnnouncementCategory {
  GENERAL
  ACADEMIC
  EVENT
  DEADLINE
}

model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  bio String @default("")
  role Role @default(STUDENT)
  status UserStatus @default(ACTIVE)
  selectedCohortId String?
  onboardingCompletedAt DateTime?
  selectedCohort Cohort? @relation("SelectedCohort", fields: [selectedCohortId], references: [id], onDelete: SetNull)
  accounts Account[]
  sessions Session[]
  discussions Discussion[]
  replies Reply[]
  announcements Announcement[]
  updatedTimetables Timetable[]
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Account {
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
  @@index([userId])
}
model Session {
  sessionToken String @id
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model VerificationToken {
  identifier String
  token String
  expires DateTime
  @@id([identifier, token])
}
model AcademicTerm {
  id String @id @default(cuid())
  name String @unique
  startsOn DateTime @db.Date
  endsOn DateTime @db.Date
  cohorts Cohort[]
}
model Cohort {
  id String @id @default(cuid())
  termId String
  term AcademicTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  programme String
  semester Int
  section String
  selectedBy User[] @relation("SelectedCohort")
  timetable Timetable?
  @@unique([termId, programme, semester, section])
}
model Discussion {
  id String @id @default(cuid())
  authorId String
  author User @relation(fields: [authorId], references: [id])
  title String
  body String @db.Text
  category DiscussionCategory
  visibility Visibility @default(VISIBLE)
  isLocked Boolean @default(false)
  isDemo Boolean @default(false)
  replies Reply[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([visibility, createdAt, id])
  @@index([authorId, createdAt])
}
model Reply {
  id String @id @default(cuid())
  discussionId String
  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id])
  body String @db.Text
  visibility Visibility @default(VISIBLE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([discussionId, visibility, createdAt, id])
}
model Announcement {
  id String @id @default(cuid())
  authorId String
  author User @relation(fields: [authorId], references: [id])
  title String
  body String @db.Text
  category AnnouncementCategory
  status AnnouncementStatus @default(DRAFT)
  isPinned Boolean @default(false)
  publishedAt DateTime?
  expiresAt DateTime?
  isDemo Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, publishedAt, expiresAt])
}
model Timetable {
  id String @id @default(cuid())
  cohortId String @unique
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  timezone String @default("Asia/Kolkata")
  version Int @default(1)
  updatedById String
  updatedBy User @relation(fields: [updatedById], references: [id])
  isDemo Boolean @default(false)
  entries TimetableEntry[]
  updatedAt DateTime @updatedAt
}
model TimetableEntry {
  id String @id @default(cuid())
  timetableId String
  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  weekday Int
  startMinute Int
  endMinute Int
  courseCode String
  courseTitle String
  room String
  instructor String?
  @@index([timetableId, weekday, startMinute])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields: [actorId], references: [id])
  action String
  entityType String
  entityId String
  reason String?
  createdAt DateTime @default(now())
  @@index([entityType, entityId, createdAt])
}
model RateLimit {
  key String @id
  count Int @default(0)
  resetsAt DateTime
}
